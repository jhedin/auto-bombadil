{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": [
      "es2021",
      "dom"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@antithesishq/bombadil/browser/dom": [
        "../node_modules/@antithesishq/bombadil/dist/browser/dom.d.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}
